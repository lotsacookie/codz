* text=auto
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
